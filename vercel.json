{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/render.ts": {
      "includeFiles": "api/_shell.html"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    {
      "source": "/((?!api/|assets/|src/|og/|sw\\.js|workbox-|favicon|icon|pwa-|apple-touch|site\\.webmanifest|manifest\\.json|og-image|robots\\.txt|sitemap\\.xml|llms).*)",
      "destination": "/api/render?__path=/$1"
    }
  ]
}
